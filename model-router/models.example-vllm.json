{
    "listen_host": "0.0.0.0",
    "listen_port": 8888,
    "backend_url": "http://127.0.0.1:8001",
    "default_model": "Qwen3.6-35B-A3B-NVFP4",
    "drain_timeout_s": 1800,
    "ready_timeout_s": 2700,
    "models": {
        "Qwen3.6-35B-A3B-NVFP4": {
            "engine": "vllm",
            "weights_links": "cache",
            "aliases": [
                "35b",
                "qwen3.6-35b"
            ],
            "dir": "~/recipes/qwen3.6-35b",
            "start": "HOST=127.0.0.1 PORT=8001 ./start.sh",
            "stop": "./stop.sh",
            "served_name": "unsloth/Qwen3.6-35B-A3B-NVFP4",
            "container": "Qwen3.6-35B-A3B-NVFP4",
            "hf_repo": "unsloth/Qwen3.6-35B-A3B-NVFP4",
            "weights_update": "HF_HUB_OFFLINE=0 ~/recipes/qwen3.8-flash-next/.venv/bin/hf download unsloth/Qwen3.6-35B-A3B-NVFP4",
            "mm_warmup": true,
            "effort": "budget"
        },
        "Qwen3.8-Flash-Next-NVFP4": {
            "engine": "vllm",
            "aliases": [
                "flash",
                "flash-next"
            ],
            "dir": "~/recipes/qwen3.8-flash-next",
            "start": "BIND=127.0.0.1 PORT=8001 ./start.sh",
            "stop": "./stop.sh",
            "served_name": "qwen3.8-flash-next",
            "container": "Qwen3.8-Flash-Next-NVFP4",
            "hf_repo": "YOUR-ORG/Qwen3.8-Flash-Next-NVFP4",
            "weights_update": "source .venv/bin/activate && ./download.sh",
            "mm_warmup": true,
            "effort": "template"
        },
        "Qwen3.8-Flash-Next-EXL3-4.05bpw-TensorFold": {
            "engine": "tensorfold",
            "aliases": [
                "flash-tf",
                "tf",
                "tensorfold"
            ],
            "dir": "~/recipes/qwen38-flash-next-dgx-spark",
            "start": "./local/start.sh",
            "stop": "./local/stop.sh",
            "served_name": "Qwen3.8-Flash-Next-EXL3-4.05bpw-TensorFold",
            "container": "Qwen3.8-Flash-Next-EXL3-4.05bpw-TensorFold",
            "hf_repo": "turboderp/Qwen3.8-Flash-Next-exl3",
            "hf_branch": "4.05bpw_h6_ng6",
            "weights_update": "./local/download.sh",
            "image_cmd": "./local/image.sh ref",
            "image_update": "./local/image.sh update",
            "image_build": true,
            "update_check": "./local/check-update.sh",
            "mm_warmup": true,
            "effort": "template"
        },
        "Qwen3.6-35B-A3B-EXL3-6.00bpw-TensorFold": {
            "engine": "tensorfold",
            "aliases": [
                "35b-tf",
                "35b-exl3"
            ],
            "dir": "~/recipes/qwen36-35b-a3b-exl3-tensorfold-dgx-spark",
            "start": "./local/start.sh",
            "stop": "./local/stop.sh",
            "served_name": "Qwen3.6-35B-A3B-EXL3-6.00bpw-TensorFold",
            "container": "Qwen3.6-35B-A3B-EXL3-6.00bpw-TensorFold",
            "hf_repo": "yeasah/Qwen3.6-35B-A3B-exl3",
            "hf_branch": "6.00bpw",
            "weights_update": "./local/download.sh --follow",
            "image_cmd": "./local/image.sh ref",
            "image_update": "./local/image.sh update",
            "image_build": true,
            "update_check": "./local/check-update.sh",
            "effort": "budget"
        }
    },
    "update_check_interval_s": 21600
}
